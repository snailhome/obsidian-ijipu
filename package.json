{
  "name": "obsidian-ijipu",
  "version": "0.4.0",
  "description": "Obsidian 插件：.jps 简谱渲染 + 试听（复用 @ijipu/engine）",
  "main": "main.js",
  "scripts": {
    "dev": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "smoke": "esbuild scripts/smoke-frontmatter.mts --bundle --platform=node --format=esm --target=node20 --log-level=warning --alias:@ijipu/engine=./vendor/engine/index.ts --outfile=dist-smoke/smoke.mjs && node dist-smoke/smoke.mjs"
  },
  "keywords": ["obsidian", "简谱", "jps", "ijipu"],
  "license": "AGPL-3.0",
  "dependencies": {
    "spessasynth_core": "^4.3.22",
    "spessasynth_lib": "^4.3.14"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.5.12",
    "typescript": "^5.6.0",
    "vite": "8.2.1"
  }
}
